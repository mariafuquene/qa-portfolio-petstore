              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CP-01: registrar una mascota valida responde 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"CP-01: devuelve el nombre y el estado enviados\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.name).to.eql(\"Luna\");\r\n    pm.expect(body.status).to.eql(\"available\");\r\n});\r\n\r\nconst body = pm.response.json();\r\npm.environment.set(\"petId\", body.id);"
                ]
              }
            }
